{
  "name": "jobuhan",
  "productName": "Jobuhan",
  "version": "0.1.0",
  "private": true,
  "author": "じょぶはん開発チーム",
  "description": "面接・面談の練習と振り返りを支援するWindowsデスクトップアプリ",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently --kill-others -n Vite,Electron \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "npm run build && electron .",
    "make": "npm run build && electron-forge make",
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:main && vite build",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
